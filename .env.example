# Copy this file to ".env" and fill in your keys. ".env" is never committed.

# Voice (text-to-speech). Provider is swappable: elevenlabs | (more later)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# The channel voice. Kristen = lXiPxoDwq0d2OK7NdaXw (soft, warm storyteller)
ELEVENLABS_VOICE_ID=lXiPxoDwq0d2OK7NdaXw
ELEVENLABS_MODEL=eleven_multilingual_v2
# Reading speed (0.7-1.2). 1.08 keeps Kristen soft but fits ~52 words in 20-25s.
ELEVENLABS_SPEED=1.08

# Stock footage
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Speech-to-text model for captions: tiny | base | small | medium
# ("small" is a good balance; your RTX 4050 can handle "medium")
WHISPER_MODEL=small
# cpu works everywhere. "cuda" uses your RTX GPU but needs NVIDIA CUDA/cuDNN installed.
WHISPER_DEVICE=cpu

# Lets the downloader use your own logged-in browser for Facebook/Instagram/TikTok posts.
# Set to: chrome, edge or firefox (close that browser first). Leave empty to skip.
YTDLP_COOKIES_BROWSER=

# --- Daily run on your laptop ---
# Synced Google Drive folder where Grok drops stories (setup fills this in automatically)
DRIVE_DROP_DIR=
# Where finished videos are saved (empty = your Videos\Warm Hearts Daily folder)
VIDEOS_DIR=
# Also copy finished videos into Drive's "Finished" folder? yes/no
COPY_TO_DRIVE=yes
# How long to wait for Grok's upload to finish syncing (minutes)
WAIT_MINUTES=60
# Open the finished folder when done? yes/no
OPEN_FOLDER_WHEN_DONE=yes
