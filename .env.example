# Copy this file to ".env" and fill in your keys. ".env" is never committed.

# Voice (text-to-speech). Provider is swappable: elevenlabs | (more later)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# The channel voice. Brian = nPczCjzI2devNBz1zQrb
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Stock footage
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Speech-to-text model for captions: tiny | base | small | medium
# ("small" is a good balance; your RTX 4050 can handle "medium")
WHISPER_MODEL=small
# cpu works everywhere. "cuda" uses your RTX GPU but needs NVIDIA CUDA/cuDNN installed.
WHISPER_DEVICE=cpu
